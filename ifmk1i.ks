SET S TO SHIP.
PRINT "WAITING UNTIL NODE EXISTS".
WAIT UNTIL HASNODE.
PRINT "NODE FOUND. WARPING IN 5...".
FOR COUNTDOWN IN LIST(4,3,2,1) {
	WAIT 1.
	PRINT COUNTDOWN.
}
SET KUNIVERSE:TIMEWARP:MODE TO "RAILS".
UNTIL NEXTNODE:ETA < 155 {
	IF NEXTNODE:ETA > 9*60 SET KUNIVERSE:TIMEWARP:RATE TO 1000.
	ELSE {
		IF NEXTNODE:ETA > 3*60 SET KUNIVERSE:TIMEWARP:RATE TO 100.
		ELSE {
			IF NEXTNODE:ETA > 165 SET KUNIVERSE:TIMEWARP:RATE TO 10.
		}
	}
}
SET KUNIVERSE:TIMEWARP:WARP TO 0.
WAIT UNTIL NEXTNODE:ETA < 120.
PRINT "ORIENTING".
LOCK STEERING TO NEXTNODE.
WAIT 60.
S:PARTS[0]:GETMODULEBYINDEX(12):DOACTION("deactivate smartacs",TRUE).
SET S:PARTS[0]:RESOURCES[0]:ENABLED TO TRUE.
SET TARGETDV TO NEXTNODE:DELTAV:MAG.
SET DV TO 0.
SET DT TO 0.001.
SET ITER TO 0.
SET CUTOFF TO 0.
WAIT UNTIL NEXTNODE:ETA < 15.
SET S:CONTROL:TRANSLATION TO V(0,0,1).
WAIT 13.
SET S:CONTROL:TRANSLATION TO V(0,0,0).
WAIT 0.6.
STAGE.
LOCK THROTTLE TO 1.
UNLOCK STEERING.
SET M0 TO S:MASS.
UNTIL CUTOFF = 1 {
	SET MF TO SHIP:MASS.
	SET DV TO S:PARTS[23]:GETMODULEBYINDEX(1):GETFIELD("specific impulse") * CONSTANT:g0 * ln(M0/MF) * VDOT(SHIP:FACING:VECTOR:NORMALIZED,NEXTNODE:DELTAV:NORMALIZED).
	SET ITER TO ITER + 1.
	IF MOD(ITER,.50*1/DT) = 0 {
		PRINT ROUND(DV,2) + " dV, " + round(M0-MF,1) + " dM".
	}
	IF DV = 0 SET M0 TO S:MASS.
	IF ITER > 120 * (1/DT) {
		SET CUTOFF TO 1.
		PRINT "CUTOFF DUE TO TIMEOUT.".
	}
	IF DV >= TARGETDV {
		SET CUTOFF TO 1.
		PRINT "CUTOFF DUE TO EXCEEDING dV TARGET.".
	}
}
LOCK THROTTLE TO 0.
PRINT "TOTAL DV EXPENDED " + ROUND(DV,1).
WAIT 1.
UNLOCK THROTTLE.
STAGE.
WAIT 3.
STAGE.
SET S:CONTROL:TRANSLATION TO V(0,0,1).
WAIT 2.
SET S:CONTROL:TRANSLATION TO V(0,0,0).
S:PARTS[0]:GETMODULEBYINDEX(12):DOACTION("orbit kill rotation",TRUE).
PRINT "KILLING ROTATION".
WAIT 120.
S:PARTS[0]:GETMODULEBYINDEX(12):DOACTION("deactivate smartacs",TRUE).
WAIT 1.
S:PARTS[2]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
S:PARTS[3]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
S:PARTS[4]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
WAIT 3.
S:PARTS[1]:GETMODULE("ModuleDeployableAntenna"):DOEVENT("extend antenna").
WAIT 3.
PRINT "WAITING UNTIL NODE EXISTS".
WAIT UNTIL HASNODE.
WAIT UNTIL NEXTNODE:ETA < 60.
PRINT "ORIENTING".
LOCK STEERING TO NEXTNODE.
WAIT UNTIL NEXTNODE:ETA < 0.01.
SET DV TO 0.
SET M0 TO S:MASS.
SET ITER TO 0.
LOCK THROTTLE TO 1.
UNTIL CUTOFF = 1 {
	SET MF TO SHIP:MASS.
	SET DV TO S:PARTS[8]:GETMODULEBYINDEX(0):GETFIELD("specific impulse") * CONSTANT:g0 * ln(M0/MF) * VDOT(SHIP:FACING:VECTOR:NORMALIZED,NEXTNODE:DELTAV:NORMALIZED).
	SET ITER TO ITER + 1.
	IF MOD(ITER,.50*1/DT) = 0 {
		PRINT ROUND(DV,2) + " dV, " + round(M0-MF,1) + " dM".
	}
	IF DV = 0 SET M0 TO S:MASS.
	IF ITER > 120 * (1/DT) {
		SET CUTOFF TO 1.
		PRINT "CUTOFF DUE TO TIMEOUT.".
	}
	IF DV >= TARGETDV {
		SET CUTOFF TO 1.
		PRINT "CUTOFF DUE TO EXCEEDING dV TARGET.".
	}
}
LOCK THROTTLE TO 0.
WAIT 1. 
UNLOCK THROTTLE.
PRINT "PAUSING FOR CORRECTIONS."
WAIT 3600.
PRINT "30 SECONDS UNTIL SOLAR PANEL ORIENTATION.".
WAIT 30.
LOCK STEERING TO SUN:DIRECTION.
WAIT 60.
PRINT "ENTERING HIBERNATION".
S:PARTS[0]:GETMODULE("ModuleCommand"):DOACTION("toggle hibernation",TRUE).