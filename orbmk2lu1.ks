SET S TO SHIP.
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(18,90).
STAGE.
WAIT UNTIL S:THRUST>600.
STAGE.
WAIT UNTIL S:ALTITUDE>5000.
SET T TO 1.
LOCK STEERING TO HEADING(18,90-0.1*T).
// WHEN S:ORBIT:VELOCITY:ORBIT:MAG>4380 THEN LOCK THROTTLE TO 0.
UNTIL T>900 {WAIT 0.0265*LN(T).
	SET T TO T+1.
	IF S:THRUST<1 SET T TO 901.
}
WAIT UNTIL S:THRUST<1.
LOCK THROTTLE TO 1.
STAGE.
WAIT 2.
LOCK THROTTLE TO 0.
LOCK STEERING TO HEADING(18,-3.5).
WAIT UNTIL ETA:APOAPSIS<140.
UNLOCK STEERING.
SET S:CONTROL:ROLL TO 1.
LOCK THROTTLE TO 1.
WAIT 40.
LOCK THROTTLE TO 0.
SET S:CONTROL:ROLL TO 0.
WAIT 0.1.
STAGE.
WAIT 0.5.
LOCK THROTTLE TO 1.
WHEN S:OBT:PERIAPSIS > 220000 THEN LOCK THROTTLE TO 0.
WAIT 10.
WAIT UNTIL S:THRUST < 1.
LOCK THROTTLE TO 0.
S:PARTS[2]:GETMODULE("Experiment"):DOACTION("Start: Photography 2",TRUE).