SET S TO SHIP.
CORE:PART:GETMODULE("kOSProcessor"):DOEVENT("Open Terminal").
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(90,90).
STAGE.
WAIT UNTIL S:THRUST>600.
STAGE.
WHEN S:THRUST<779 THEN STAGE.
WAIT UNTIL S:ALTITUDE>2000.
SET T TO 1.
LOCK STEERING TO HEADING(90,90-0.1*T).
WHEN S:ALTITUDE > 65000 THEN STAGE.
WHEN S:THRUST < 2.95 THEN STAGE.
UNTIL T>825 {WAIT 0.0415 * ln(t).
	SET T TO T+1.
}
WHEN S:OBT:PERIAPSIS > 160000 THEN LOCK THROTTLE TO 0.
WAIT UNTIL S:THRUST < 1.
WAIT 5.
LOCK THROTTLE TO 0.
WAIT 1.
STAGE.
RCS ON.
LOCK THROTTLE TO 1.
WAIT 2.
UNLOCK STEERING.
LOCK THROTTLE TO 0.
