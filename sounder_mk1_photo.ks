SET S TO SHIP.
LOCK THROTTLE TO 1.
LOCK STEERING TO R(0,0,-90) + HEADING(90,90).
STAGE.
WAIT UNTIL S:THRUST > 270.
STAGE.
WAIT UNTIL S:ALTITUDE > 1000.
SET T TO 1.
LOCK STEERING TO HEADING(90,90-0.1*T).
UNTIL T>300 {WAIT 0.04*LN(T).
	SET T TO T+1.
	IF S:THRUST<1 SET T TO 301.
}
WAIT UNTIL S:THRUST = 0.
LOCK THROTTLE TO 0.
WAIT UNTIL S:ALTITUDE > 50000.
STAGE.
WAIT 0.5.
LOCK THROTTLE TO 1.
WAIT UNTIL S:ALTITUDE > (S:APOAPSIS - 1000).
WAIT UNTIL S:ALTITUDE < 100000.
WAIT 2.
S:PARTS[0]:getmodule("HardDrive"):DOEVENT("transfer data here").
WAIT 0.5.
STAGE.
WAIT UNTIL S:ALTITUDE < 20000.
STAGE.