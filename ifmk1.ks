SET S TO SHIP.
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(75,90).
STAGE.
WAIT UNTIL S:THRUST > 1200.
STAGE.
WAIT UNTIL S:ALTITUDE>500.
SET T TO 1.
LOCK STEERING TO HEADING(75,90-0.1*T).
WHEN S:OBT:APOAPSIS > 150000 THEN STAGE.
WHEN S:ALTITUDE > 65000 THEN STAGE.
WHEN S:THRUST < 3 THEN {STAGE. WAIT 5.}.
UNTIL T>873 {WAIT 0.024 * ln(t).
	SET T TO T+1.
}
PRINT "GRAVITY TURN COMPLETE".
WHEN S:OBT:PERIAPSIS > 190000 THEN LOCK THROTTLE TO 0.
WAIT UNTIL S:THRUST < 1.
WAIT 1.	
LOCK THROTTLE TO 0.
SET S:PARTS[25]:RESOURCES[0]:ENABLED TO TRUE.
WAIT 1.
STAGE.
RCS ON.
SET S:CONTROL:TRANSLATION TO V(0,0,1).
WAIT 10.
SET S:CONTROL:TRANSLATION TO V(0,0,0).
WAIT 1.
UNLOCK THROTTLE.
UNLOCK STEERING.