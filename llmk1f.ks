SET S TO SHIP.
SET DT TO 0.001.
WAIT UNTIL S:OBT:BODY = Moon.
WAIT UNTIL S:ALTITUDE < 500000.
UNTIL ABS(ALT:RADAR/S:VERTICALSPEED) < 300 {
	PRINT "TIME TO IMPACT: " + ROUND(ABS(ALT:RADAR/S:VERTICALSPEED),1).
	WAIT 1.
}
KUNIVERSE:TIMEWARP:CANCELWARP.
PRINT "WAKING FROM HIBERNATION".
S:PARTS[0]:GETMODULE("ModuleCommand"):DOACTION("toggle hibernation",FALSE).
WAIT 0.5.
S:PARTS[0]:GETMODULEBYINDEX(12):DOACTION("orbit retrograde",TRUE).
PRINT "PERFORMING INITIAL ALIGNMENT".
WAIT UNTIL ABS(ALT:RADAR/S:VERTICALSPEED) < 150.
KUNIVERSE:TIMEWARP:CANCELWARP.
WAIT 1.
S:PARTS[0]:GETMODULEBYINDEX(12):DOACTION("deactivate smartacs",TRUE).
PRINT "FINE-TUNING ALIGNMENT".
LOCK STEERING TO SRFRETROGRADE.
LOCK THROTTLE TO 0.
SET ITER TO 0.
UNTIL ABS((ALT:RADAR-8500)/S:VERTICALSPEED) + 5 <= S:PARTS[18]:RESOURCES[0]:AMOUNT/S:ENGINES[3]:MAXFUELFLOW {
	SET ITER TO ITER + 1.
	IF MOD(ITER,1/DT) = 0 {
		PRINT "TIME TO IMPACT: " + ROUND(ABS((ALT:RADAR-8500)/S:VERTICALSPEED),1) + ", BURN TIME = " + ROUND(S:PARTS[18]:RESOURCES[0]:AMOUNT/S:ENGINES[3]:MAXFUELFLOW,2) + ", ALTITUDE = " + ROUND(ALT:RADAR-8500,2) + ", VERT SPEED = " + ROUND(ABS(S:VERTICALSPEED),2).
	}
}
STAGE.
WAIT UNTIL S:THRUST < 0.5.
STAGE.
WAIT UNTIL S:VERTICALSPEED < 0.
WAIT UNTIL ALT:RADAR < 3000.
UNTIL ALT:RADAR < 2000 {
	IF SHIP:VELOCITY:SURFACE:MAG > 80 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 1500 {
	IF SHIP:VELOCITY:SURFACE:MAG > 60 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 800 {
	IF SHIP:VELOCITY:SURFACE:MAG > 45 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 300 {
	IF SHIP:VELOCITY:SURFACE:MAG > 30 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 100 {
	IF SHIP:VELOCITY:SURFACE:MAG > 15 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 25 {
	IF SHIP:VELOCITY:SURFACE:MAG > 8 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 10 {
	IF SHIP:VELOCITY:SURFACE:MAG > 3 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
UNTIL ALT:RADAR < 2.5 {
	IF SHIP:VELOCITY:SURFACE:MAG > 1 AND S:VERTICALSPEED < 0 {
		LOCK THROTTLE TO 1.
	}
	ELSE {
		LOCK THROTTLE TO 0.
	}
}
LOCK THROTTLE TO 0.
UNLOCK STEERING.
UNLOCK THROTTLE.
WAIT 60.
S:PARTS[2]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
S:PARTS[3]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
S:PARTS[4]:GETMODULEBYINDEX(1):DOEVENT("extend solar panel").
WAIT 10.
S:PARTS[0]:GETMODULE("ModuleCommand"):DOACTION("toggle hibernation",TRUE).