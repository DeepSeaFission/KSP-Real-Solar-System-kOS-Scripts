SET S TO SHIP.
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(359,90).
STAGE.
WAIT UNTIL S:THRUST > 590.
STAGE.
WAIT UNTIL S:ALTITUDE > 5000.
SET IT TO 1.
FROM {LOCAL A IS 90.} UNTIL A < 0 STEP {SET A TO ROUND(A - 0.1,1).} DO {
	LOCK STEERING TO R(0,0,-90) + HEADING(359,A).
	WAIT 0.03 * LN(IT).
	SET IT TO IT + 1.
}
WAIT UNTIL S:THRUST < 1.
STAGE.
WAIT 2.
LOCK THROTTLE TO 0.
LOCK STEERING TO HEADING(0,-4).
WAIT UNTIL ETA:APOAPSIS < 150.
UNLOCK STEERING.
SET S:CONTROL:ROLL TO 1.
WAIT UNTIL ETA:APOAPSIS < 100.
LOCK THROTTLE TO 1.
WAIT 30.
LOCK THROTTLE TO 0.
SET ROLL TO 0.
WAIT 0.1.
STAGE.
WAIT 0.5.
LOCK THROTTLE TO 1.
WAIT 200.
STAGE.