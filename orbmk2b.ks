SET S TO SHIP.
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(90,90).
STAGE.
WAIT UNTIL S:THRUST>600.
STAGE.
WAIT UNTIL S:ALTITUDE>5000.
SET T TO 1.
LOCK STEERING TO HEADING(90,90-0.1*T).
// WHEN S:ORBIT:VELOCITY:ORBIT:MAG>4380 THEN LOCK THROTTLE TO 0.
UNTIL T>900 {WAIT 0.024*LN(T).
	SET T TO T+1.
	IF S:THRUST<1 SET T TO 901.
}
WAIT UNTIL S:THRUST<1.
LOCK THROTTLE TO 1.
STAGE.
WAIT 2.
LOCK THROTTLE TO 0.
LOCK STEERING TO HEADING(90,-3.1).
WAIT UNTIL ETA:APOAPSIS<120.
UNLOCK STEERING.
SET S:CONTROL:ROLL TO 1.
LOCK THROTTLE TO 1.
WAIT 40.
LOCK THROTTLE TO 0.
SET S:CONTROL:ROLL TO 0.
WAIT 0.1.
STAGE.
WAIT 0.5.
WHEN S:OBT:APOAPSIS > 220000 THEN LOCK THROTTLE TO 0.
LOCK THROTTLE TO 1.
WAIT 200.
LOCK THROTTLE TO 0.
STAGE.
S:PARTS[7]:GETMODULE("Experiment"):DOACTION("Start: Biological Sample 2",TRUE).