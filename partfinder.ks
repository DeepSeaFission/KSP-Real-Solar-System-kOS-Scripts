DECLARE FUNCTION PARTFINDER {
	PARAMETER NAME_STRING.
	PARAMETER PART_ITER.

	LOCAL STOP IS 0.
	LOCAL PART_NUM IS 0.
	LOCAL PART_NAME_HITS IS 0.

	UNTIL STOP {
		IF SHIP:PARTS[PART_NUM]:NAME:CONTAINS(NAME_STRING) {
			SET PART_NAME_HITS TO PART_NAME_HITS + 1.
			IF PART_NAME_HITS >= PART_ITER {
				RETURN PART_NUM.
			}
			ELSE {
				SET PART_NUM TO PART_NUM + 1.
			}
		}
		ELSE IF PART_NUM = SHIP:PARTS:LENGTH {
			PRINT "NO MATCHING PART FOUND".
			BREAK.
		}
		ELSE {
			SET PART_NUM TO PART_NUM + 1.
		}
	}
}