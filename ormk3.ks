SET S TO SHIP.
CORE:PART:GETMODULE("kOSProcessor"):DOEVENT("Open Terminal").
LOCK THROTTLE TO 1.
LOCK STEERING TO HEADING(357,90).
STAGE.
WAIT UNTIL S:THRUST>600.
STAGE.
WHEN S:THRUST<779 THEN STAGE.
WAIT UNTIL S:ALTITUDE>2000.
SET T TO 1.
LOCK STEERING TO HEADING(357,90-0.1*T).
WHEN S:ALTITUDE > 65000 THEN STAGE.
WHEN S:THRUST < 3 THEN STAGE.
UNTIL T>825 {WAIT 0.0415 * ln(t).
	SET T TO T+1.
}
WAIT UNTIL S:THRUST < 1.
WAIT 1.	
LOCK THROTTLE TO 0.
SET S:PARTS[0]:RESOURCES[0]:ENABLED TO TRUE.
WAIT 1.
STAGE.
UNLOCK STEERING.
WAIT 60.
STAGE.
RCS ON.
S:PARTS[1]:GETMODULE("ModuleDeployableAntenna"):DOEVENT("extend antenna").
UNLOCK THROTTLE.
WAIT 10.
LOCK STEERING TO SUN:DIRECTION.
WAIT 60.
S:PARTS[0]:GETMODULE("ModuleCommand"):DOACTION("toggle hibernation",TRUE).
UNLOCK STEERING.